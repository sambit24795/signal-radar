# --- radar pipeline ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEEPSEEK_API_KEY=
NOTION_TOKEN=

# --- database / api ---
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
TEST_DATABASE_URL=postgres://radar:radar@localhost:5432/radar_test
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32chars-min
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
API_PORT=8787
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Razorpay prepaid passes. Unset = Buy buttons hidden / payments closed. Webhook: /api/billing/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- web push (Pro). Unset = push disabled. Generate: pnpm --filter @radar/core exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- telegram connect (Pro). Unset = Connect Telegram hidden. Webhook: radar telegram:webhook <publicBaseUrl>
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- web build. Public origin of the web app, used for canonical/Open Graph URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=http://localhost:5173

# --- YouTube in search. Unset = YouTube left out. Google Cloud Console: enable "YouTube Data API v3", create an API key restricted to that API. Server-side only; free tier is about 100 searches a day.
YOUTUBE_API_KEY=
